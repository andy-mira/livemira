{
  "name": "livemira",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=25.9.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "typecheck": "tsc -b",
    "check:structure": "node tools/check-structure.ts",
    "check:content": "node tools/check-content.ts",
    "check:wasm": "node tools/build-wasm.ts --check",
    "build": "tsc -b && node tools/build-engine.ts && node tools/build-types.ts && node tools/build-demo.ts && node tools/pack.ts",
    "build:packages": "node tools/pack.ts",
    "build:types": "node tools/build-types.ts",
    "check:api": "node tools/build-types.ts --check",
    "check:version": "node tools/sync-version.ts --check",
    "version:sync": "node tools/sync-version.ts",
    "build:wasm": "node tools/build-wasm.ts",
    "test": "node --test \"packages/*/test/**/*.test.ts\" \"tests/**/*.test.ts\" \"tools/**/*.test.ts\"",
    "test:browser": "node --test \"tests/browser/**/*.probe.ts\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:api && npm run check:version && npm run check:structure && npm run check:content && npm run check:wasm && npm test",
    "build:demo": "node tools/build-demo.ts",
    "dev": "node tools/build-demo.ts && node tools/dev-server.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@microsoft/api-extractor": "7.59.2",
    "@types/node": "25.9.9",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "playwright-core": "1.59.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "wabt": "1.0.39"
  }
}
